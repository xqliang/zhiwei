# Cordis loads plugins by bare package name at runtime; their peerDependencies
# (dsh-agent, dsh-llm, dsh-session, cordis, ...) must physically exist in
# node_modules. pnpm auto-installs peers so we don't have to enumerate the
# entire transitive peer closure by hand.
auto-install-peers=true
# The dsh packages declare wide peer ranges across the rc line; don't fail the
# install on a peer-range quibble during a spike.
strict-peer-dependencies=false
# These published packages ship lifecycle scripts we actually need at runtime
# (esbuild native binary, node-pty PTY backend). Allow them explicitly.
