data/
testdata/
bin/
*.log
.env
.run/
logs/
# web/app.<hash>.js 是 make hash-web 生成的缓存破除副本（源文件 web/app.js 不匹配此模式）
web/app.*.js
# cmd/spike/* 用 go build 跑时会在 cwd 落同名二进制（asr/tos/llm/embed），勿提交
/asr
/tos
/llm
/embed
# 主服务 go build 落在仓库根的二进制，勿提交
/zhiwei-server
/zhiwei-adduser
# 声纹 sidecar 的本地测试 venv（py3.14 + fastapi/numpy），勿提交
services/voiceprint/.venv/
# Python 字节码缓存（sidecar 引入 Python 后新增）
__pycache__/
*.pyc
# git worktree 目录（feature 分支/模型对比隔离工作区），勿提交
.worktrees/
.claude/worktrees/
.workbuddy/
.DS_Store
